# ═══════════════════════════════════════════════════════════════
#  Autify Engine V1 — Environment Configuration
#  All values are overridable. Ports are high-numbered to avoid conflicts.
# ═══════════════════════════════════════════════════════════════

# Ports
BACKEND_PORT=18080
DASHBOARD_PORT=18300
LLM_PORT=18434

# Database
DB_PATH=data/db.sqlite
DATABASE_URL=sqlite:///./data/db.sqlite

# LLM (local only — Zero-Cloud)
LLM_HOST=localhost
LLM_MODEL=llama3

# License
LICENSE_SERVER_URL=http://localhost:9090
LICENSE_FILE_PATH=license.json

# Telemetry (opt-in only)
TELEMETRY_ENABLED=false
