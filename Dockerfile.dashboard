# ═══════════════════════════════════════════════════════════════
#  Autify Engine V1 — Dashboard Dockerfile
#  React + Vite frontend, built to static files and served
#  by a lightweight Node server (Zero-Cloud).
# ═══════════════════════════════════════════════════════════════

# ── Stage 1: Build ────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm install

COPY dashboard/ .
RUN npm run build

# ── Stage 2: Serve with nginx (reverse-proxy for /api) ────────
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config with /api proxy
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 18300

CMD ["nginx", "-g", "daemon off;"]
